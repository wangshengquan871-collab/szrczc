NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# false for direct local access; use loopback for a local HTTPS reverse proxy.
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=suzhou_app
DB_PASSWORD=replace_with_your_database_password
DB_NAME=suzhou_talent_policy
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
# Optional: a separate account with CREATE/ALTER privileges for migrations only.
# MIGRATION_DB_USER=root
# MIGRATION_DB_PASSWORD=fill_locally_then_remove_after_migration
# Required for remote MySQL. Verification is always enabled when using TLS.
DB_SSL=false
DB_SSL_CA=

# Required by the real authentication server. Keep this key stable across restarts.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
SESSION_HOURS=8
REMEMBER_DAYS=14
BCRYPT_COST=12
